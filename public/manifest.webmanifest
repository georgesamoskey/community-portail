{
  "id": "/?source=pwa",
  "name": "Akiba One",
  "short_name": "Akiba One",
  "description": "Épargne collective, tontines ASCA, chat de groupe et paiements Mobile Money — disponible hors ligne.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/app?utm_source=pwa&utm_medium=homescreen",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui",
    "browser"
