{
  "framework": "nextjs",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/splash/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/realms/:path*",
      "destination": "http://172.238.237.76:8099/realms/:path*"
    },
    {
      "source": "/resources/:path*",
      "destination": "http://172.238.237.76:8099/resources/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "http://172.238.237.76:3000/socket.io"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://172.238.237.76:3000/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://172.238.237.76:3000/uploads/:path*"
    },
    {
      "source": "/admin",
      "destination": "http://172.238.237.76:3001/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "http://172.238.237.76:3001/admin/:path*"
    },
    {
      "source": "/api/auth/login",
      "destination": "http://172.238.237.76:3000/api/auth/login"
    },
    {
      "source": "/api/auth/register",
      "destination": "http://172.238.237.76:3000/api/auth/register"
    },
    {
      "source": "/api/auth/otp/:path*",
      "destination": "http://172.238.237.76:3000/api/auth/otp/:path*"
