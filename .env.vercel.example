# Variables à configurer sur Vercel (Project → Settings → Environment Variables)
# Production API / auth = VPS akibaone

NEXT_PUBLIC_EAGASEKE_ORIGIN=https://akibaone.duckdns.org
NEXT_PUBLIC_EAGASEKE_WS_ORIGIN=https://akibaone.duckdns.org
NEXT_PUBLIC_CMS_URL=https://akibaone.duckdns.org

AUTH_SECRET=générer-avec-openssl-rand-base64-32
AUTH_URL=https://VOTRE-PROJET.vercel.app
AUTH_KEYCLOAK_ISSUER=https://akibaone.duckdns.org/realms/community-platform
AUTH_KEYCLOAK_ID=portal
AUTH_KEYCLOAK_SECRET=…secret Keycloak client portal…

# Optionnel push PWA
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=…

# Keycloak : ajouter dans Valid Redirect URIs du client « portal » :
#   https://VOTRE-PROJET.vercel.app/api/auth/callback/keycloak
# Web Origins :
#   https://VOTRE-PROJET.vercel.app
